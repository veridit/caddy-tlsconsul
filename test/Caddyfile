{
	# Use pebble as the ACME CA
	acme_ca https://pebble:14000/dir

	# Trust pebble's minica root CA for the ACME API TLS connection
	acme_ca_root /usr/local/share/ca-certificates/pebble-minica.crt

	# Shared cert storage via Consul
	storage consul {
		address consul:8500
		prefix caddytls
		aes_key {$CADDY_CLUSTERING_CONSUL_AESKEY}
	}

	# Debug logging to observe challenge handling
	debug

	# On-demand TLS: issue certs dynamically when requested
	on_demand_tls {
		ask http://localhost:8080/check
	}
}

# Wildcard matcher for all test domains - uses on-demand TLS
# so each new domain triggers a fresh ACME challenge
https:// {
	tls {
		on_demand
	}
	respond "Hello from {system.hostname} for {http.request.host}"
}

# Health check and on-demand TLS gatekeeper
:8080 {
	# Allow all domains for on-demand TLS
	handle /check {
		respond 200
	}
	# Health check
	handle /health {
		respond 200
	}
}
